  "topic:口语与网络用语": [
    {
      "source": "やばい",
      "target": "太夸张了",
      "aliases": [],
      "note": "正面可用厉害、绝了；负面可用糟了、危险。必须看上下文，不固定成同一个词。",
      "variants": [
        "ヤバい",
        "やば",
        "ヤバ"
      ]
    },
    {
      "source": "えぐい",
      "target": "太狠了",
      "aliases": [],
      "note": "可赞叹强得离谱，也可表示残酷、过分；不固定为恶心。",
      "variants": [
        "エグい",
        "えぐ"
      ]
    },
    {
      "source": "大丈夫",
      "target": "没事",
      "aliases": [],
      "note": "安慰、询问情况可用没事、可以；拒绝提议时可能是不用了，按上一句判断。",
      "variants": [
        "だいじょうぶ"
      ]
    },
    {
      "source": "結構です",
      "target": "不用了",
      "aliases": [],
      "note": "回应邀约或提供东西时常是婉拒；表示足够、满意时按原义。",
      "variants": []
    },
    {
      "source": "いいです",
      "target": "可以",
      "aliases": [],
      "note": "接受、允许时为可以；拒绝提供时可能是不用了。",
      "variants": []
    },
    {
      "source": "ちょっと",
      "target": "有点",
      "aliases": [],
      "note": "可表示稍微、等一下或委婉拒绝，不逐字固定。",
      "variants": []
    },
    {
      "source": "なんか",
      "target": "总觉得",
      "aliases": [],
      "note": "口语填充可少译；也可为某种东西，不总是“什么”。",
      "variants": []
    },
    {
      "source": "なんだろう",
      "target": "怎么回事呢",
      "aliases": [],
      "note": "困惑时的自问；不译成“要变成什么”。",
      "variants": [
        "なんになろう"
      ]
    },
    {
      "source": "ていうか",
      "target": "话说",
      "aliases": [],
      "note": "也可用“倒不如说”，保留转话题语气。",
      "variants": [
        "てか",
        "っていうか"
      ]
    },
    {
      "source": "とりあえず",
      "target": "总之先",
      "aliases": [],
      "note": "",
      "variants": []
    },
    {
      "source": "一応",
      "target": "姑且",
      "aliases": [],
      "note": "也可用算是、以防万一；按语境。",
      "variants": []
    },
    {
      "source": "普通に",
      "target": "其实挺",
      "aliases": [],
      "note": "强调时自然表达，不总是“普通地”。",
      "variants": []
    },
    {
      "source": "逆に",
      "target": "反而",
      "aliases": [],
      "note": "",
      "variants": []
    },
    {
      "source": "まじ",
      "target": "真的",
      "aliases": [],
      "note": "惊讶可译“真的假的”，强调可译“真”。",
      "variants": [
        "マジ",
        "まじで",
        "マジで"
      ]
    },
    {
      "source": "ガチ",
      "target": "认真",
      "aliases": [],
      "note": "也可表示真的、来真的，根据搭配。",
      "variants": [
        "がち"
      ]
    },
    {
      "source": "ガチで",
      "target": "真的",
      "aliases": [],
      "note": "",
      "variants": []
    },
    {
      "source": "ワンチャン",
      "target": "说不定有机会",
      "aliases": [],
      "note": "可能性或机会，不译成小狗。",
      "variants": [
        "わんちゃん"
      ]
    },
    {
      "source": "それな",
      "target": "就是啊",
      "aliases": [],
      "note": "赞同别人的话。",
      "variants": []
    },
    {
      "source": "わかる",
      "target": "懂了",
      "aliases": [],
      "note": "赞同感受时可用我懂、太懂了；询问信息时按原义。",
      "variants": []
